{
  "manifest": {
    "name": "ToolCall",
    "targets": [
      {
        "name": "caller",
        "calls": [
          {
            "method": "tool.call",
            "params": {
              "package": "deno",
              "version": "$ZUKE_DENO_VERSION",
              "tasks": "DenoTasks",
              "task": "eval",
              "args": [
                {
                  "configure": [
                    ["toolPath", ["$DENO"]],
                    ["code", ["console.log(40 + 2)"]]
                  ]
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "argv": ["caller"],
  "code": 0,
  "calls": ["build.configure", "target.run caller", "run.exit done"],
  "configure": { "parameters": {} },
  "answers": ["tool.call {\"code\":0,\"stdout\":\"42\\n\",\"stderr\":\"\"}"]
}
