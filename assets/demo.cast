[15.23, "o", "    .dependsOn(\u001b[36mthis.lint\u001b[0m)  \u001b[90m// a reference, not \"lint\"\u001b[0m\r\n"]
[15.28, "o", "    .executes(() => DenoTasks.test((s) => s.allowAll()));\r\n"]
[15.33, "o", "}\r\n"]
