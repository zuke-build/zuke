[15.19, "o", "\u001b[90mimport\u001b[0m { Build, run, target } \u001b[90mfrom\u001b[0m \"jsr:@zuke/core@^1\";\r\n"]
[15.24, "o", "\u001b[90mimport\u001b[0m { DenoTasks } \u001b[90mfrom\u001b[0m \"jsr:@zuke/deno@^1\";\r\n"]
[15.29, "o", "\r\n"]
[15.34, "o", "\u001b[90mclass\u001b[0m \u001b[33mPipeline\u001b[0m \u001b[90mextends\u001b[0m Build {\r\n"]
[15.39, "o", "  lint = target()\r\n"]
[15.44, "o", "    .description(\"Lint the workspace\")\r\n"]
[15.49, "o", "    .executes(() => DenoTasks.lint());\r\n"]
[15.54, "o", "\r\n"]
[15.59, "o", "  test = target()\r\n"]
[15.64, "o", "    .description(\"Run the test suite\")\r\n"]
[15.69, "o", "    .dependsOn(\u001b[36mthis.lint\u001b[0m)  \u001b[90m// a reference, not \"lint\"\u001b[0m\r\n"]
[15.74, "o", "    .executes(() => DenoTasks.test((s) => s.allowAll()));\r\n"]
[15.79, "o", "}\r\n"]
[15.84, "o", "\r\n"]
[15.89, "o", "\u001b[90mawait\u001b[0m run(Pipeline);\r\n"]
