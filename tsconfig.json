{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable"],
    "types": ["node", "deno"]
  },
  "include": ["packages/*/mod.ts", "packages/*/src/**/*.ts"]
}
