<!--
  Entitlements for the signed zuke binaries (build/cli_sign.ts). Under the
  hardened runtime V8 needs both: its JIT writes and executes generated code.
  Nothing else is granted — no library-validation or dyld exemptions, since a
  compiled zuke loads no third-party dynamic libraries.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
